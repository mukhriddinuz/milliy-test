# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring

# Productionda 0 bo'lishi shart
DJANGO_DEBUG=0
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Vergul bilan: milliysertifikat.nsdcorporation.uz
DJANGO_ALLOWED_HOSTS=*

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=milliy_test_sertifikat_bot
TELEGRAM_ADMIN_ID=
# Ixtiyoriy: setWebhook(secret_token=...) bilan bir xil qiymat
TELEGRAM_WEBHOOK_SECRET=
# Ixtiyoriy: log guruhi (bo'sh qoldirilsa loglar yuborilmaydi)
TELEGRAM_LOG_GROUP_ID=

# Bot tugmalari ochadigan WebApp domeni va admin panel manzili
WEBAPP_URL=https://milliysertifikat.nsdcorporation.uz
ADMIN_PANEL_URL=https://milliysertifikat.nsdcorporation.uz/admin/

# Faqat lokal sinov uchun (DJANGO_DEBUG=1): Telegram'siz shu telegram_id bilan kirish
WEBAPP_DEV_TELEGRAM_ID=

# --- Xatolar jurnali (main/errorlog.py) ---
# Xatolar API'si: /api/errors/?key=<shu kalit> (yoki Authorization: Bearer <kalit>). Bo'sh bo'lsa API o'chiq.
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(32))"
ERROR_LOG_KEY=
# Ixtiyoriy: har bir YANGI xato uchun GitHub Issue ochiladi (shaxsiy ma'lumotlar yashiriladi).
# Token: GitHub -> Settings -> Developer settings -> Fine-grained token -> faqat shu repo, "Issues: Read and write"
GITHUB_ERRORS_TOKEN=
GITHUB_ERRORS_REPO=mukhriddinuz/milliy-test
